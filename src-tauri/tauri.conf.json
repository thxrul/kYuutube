{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "kYuutube",
  "version": "0.0.1",
  "identifier": "com.thxrul.kyuutube.spike",
  "build": { "frontendDist": "../web" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "title": "kYuutube", "width": 960, "height": 680, "minWidth": 360, "minHeight": 480 }],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": { "active": false, "icon": ["icons/icon.png", "icons/icon.ico", "icons/icon.icns"] }
}
