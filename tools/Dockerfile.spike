# Native dependencies are installed inside this disposable development image.
FROM rust:1.92-bookworm@sha256:e90e846de4124376164ddfbaab4b0774c7bdeef5e738866295e5a90a34a307a2
RUN --mount=type=secret,id=system_ca,required=true \
    apt-get -o Acquire::https::CaInfo=/run/secrets/system_ca update && \
    apt-get -o Acquire::https::CaInfo=/run/secrets/system_ca install -y --no-install-recommends \
      libwebkit2gtk-4.1-dev libssl-dev libayatana-appindicator3-dev librsvg2-dev \
      libxdo-dev libmpv2 xvfb xauth dbus-x11 pulseaudio pulseaudio-utils \
      libasound2-dev python3 python3-psutil ca-certificates && \
    rm -rf /var/lib/apt/lists/*
RUN --mount=type=secret,id=system_ca,required=true \
    groupadd --gid 1000 spike && useradd --uid 1000 --gid 1000 --create-home spike && \
    RUSTUP_USE_CURL=1 CURL_CA_BUNDLE=/run/secrets/system_ca SSL_CERT_FILE=/run/secrets/system_ca \
      rustup component add rustfmt clippy --toolchain 1.92.0
WORKDIR /workspace/kYuutube
ENV CARGO_HOME=/workspace/kyuutube-native-cargo
ENV CARGO_BUILD_JOBS=2
RUN --mount=type=secret,id=system_ca,required=true \
    apt-get -o Acquire::https::CaInfo=/run/secrets/system_ca update && \
    apt-get -o Acquire::https::CaInfo=/run/secrets/system_ca install -y --no-install-recommends webkit2gtk-driver && \
    CARGO_HOME=/usr/local/cargo CARGO_HTTP_CAINFO=/run/secrets/system_ca CARGO_BUILD_JOBS=2 \
      cargo install tauri-driver --version 2.1.0 --locked && \
    rm -rf /var/lib/apt/lists/*
